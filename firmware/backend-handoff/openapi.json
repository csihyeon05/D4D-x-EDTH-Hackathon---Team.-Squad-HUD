{
  "openapi": "3.1.0",
  "info": {
    "title": "Squad Tactical C2",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "summary": "Get State",
        "operationId": "get_state_api_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get State Api State Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenarios": {
      "get": {
        "summary": "List Scenarios",
        "operationId": "list_scenarios_api_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List Scenarios Api Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenario": {
      "post": {
        "summary": "Trigger Scenario",
        "operationId": "trigger_scenario_api_scenario_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Trigger Scenario Api Scenario Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/soldiers/{sid}/ack": {
      "post": {
        "summary": "Ack",
        "operationId": "ack_api_soldiers__sid__ack_post",
        "parameters": [
          {
            "name": "sid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Sid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Ack Api Soldiers  Sid  Ack Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/briefing": {
      "post": {
        "summary": "Briefing Now",
        "operationId": "briefing_now_api_briefing_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Briefing Now Api Briefing Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/gps": {
      "get": {
        "summary": "Get Gps",
        "operationId": "get_gps_api_gps_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Gps Api Gps Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Gps",
        "operationId": "post_gps_api_gps_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GpsFix"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Post Gps Api Gps Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/gps/logs": {
      "get": {
        "summary": "Gps Logs",
        "operationId": "gps_logs_api_gps_logs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Gps Logs Api Gps Logs Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/gps/csv": {
      "get": {
        "summary": "Gps Csv",
        "description": "Download a CSV log: the current session by default, or ?name=gps_YYYYMMDD_HHMMSS.csv.",
        "operationId": "gps_csv_api_gps_csv_get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GpsFix": {
        "properties": {
          "soldier_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 255.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Soldier Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "title": "Device Id"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          },
          "fix_unix_ms": {
            "type": "integer",
            "title": "Fix Unix Ms"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "accuracy_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Accuracy M"
          },
          "heading_gps_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading Gps Deg"
          },
          "heading_compass_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading Compass Deg"
          },
          "compass_accuracy_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compass Accuracy Deg"
          },
          "speed_mps": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Mps"
          },
          "alt_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alt M"
          },
          "alt_accuracy_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Alt Accuracy M"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "fix_unix_ms",
          "lat",
          "lon",
          "accuracy_m"
        ],
        "title": "GpsFix"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScenarioReq": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "soldier_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soldier Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ScenarioReq"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
